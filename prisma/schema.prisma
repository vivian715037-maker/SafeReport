// 로컬 SQLite에 브라우저 소유권, 제보, 상태 이력을 저장합니다.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model BrowserOwner {
  id String @id @default(cuid())
  tokenHash String @unique
  createdAt DateTime @default(now())
  reports Report[]
}
model Report {
  id String @id @default(cuid())
  ownerId String
  owner BrowserOwner @relation(fields: [ownerId], references: [id])
  uploadedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  title String @default("")
  description String @default("")
  riskType String @default("기타")
  aiSummary String @default("")
  draftText String @default("")
  imagePath String
  latitude Float?
  longitude Float?
  locationLabel String @default("")
  placeType String @default("공공시설")
  status String @default("PREPARING")
  isDraft Boolean @default(true)
  isPublic Boolean @default(false)
  photoPublic Boolean @default(false)
  publicConsentAt DateTime?
  photoConsentAt DateTime?
  aiConsentAt DateTime?
  // 위험도는 AI 추정이며, 입력이 바뀌면 미평가로 초기화합니다.
  riskLevel String @default("UNKNOWN")
  riskReason String @default("")
  riskAssessedAt DateTime?
  riskModel String?
  userReportedAt DateTime?
  history ReportStatusHistory[]
}
model ReportStatusHistory {
  id String @id @default(cuid())
  reportId String
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus String
  changedAt DateTime @default(now())
  changeSource String
}
